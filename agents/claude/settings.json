{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "Edit(/Users/davidker/.claude/skills/*)"
    ],
    "defaultMode": "plan"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-npx.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-uv.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/opensessions-notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "sentry-mcp@sentry-mcp": true
  },
  "extraKnownMarketplaces": {
    "sentry-mcp": {
      "source": {
        "source": "github",
        "repo": "getsentry/sentry-mcp"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true
}
